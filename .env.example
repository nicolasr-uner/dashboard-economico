# ═══════════════════════════════════════════════════════════════════════════════
# Cerebro Económico NLA — Configuración de API Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores.
# cp .env.example .env
#
# Sin estas keys, los datos de FRED y Banxico no se descargarán.
# BCB (Brasil), World Bank y XM Colombia NO requieren keys.

# ── Banco de México (GRATIS) ─────────────────────────────────────────────────
# Registro: https://si.banxico.org.mx/tokens-api.html
# Cubre: Tasa objetivo, TIIE, CETES, USD/MXN, IPC, PIB Mexico
BANXICO_TOKEN=

# ── Federal Reserve Economic Data (GRATIS) ──────────────────────────────────
# Registro: https://fred.stlouisfed.org/docs/api/api_key.html
# Cubre: WTI, Brent, Henry Hub, Fed Funds, Treasuries 2Y/10Y, EUR/USD, DXY
#        IPC USA, Cuenta Corriente CO/MX/BR/EC via World Bank proxy
FRED_API_KEY=

# ── Google Gemini Flash (para chatbot y análisis — GRATIS) ──────────────────
# Registro: https://ai.google.dev  (15 RPM / 1M tokens/día sin costo)
# Reemplaza Anthropic — sin tarjeta de crédito requerida
GEMINI_API_KEY=

# ── Base de datos ────────────────────────────────────────────────────────────
# Sin esta variable, la app usa SQLite local (db.sqlite3, ignorado por git).
# En producción (Streamlit Cloud) define DATABASE_URL en st.secrets, NO aquí.
# Ejemplo PostgreSQL/Supabase:
# DATABASE_URL=postgresql://user:pass@host:6543/postgres
DATABASE_URL=

# ── Fuentes que NO requieren API key ────────────────────────────────────────
# BCB (Banco Central do Brasil): https://api.bcb.gov.br (publico)
# World Bank: https://api.worldbank.org (publico)
# XM Colombia: https://servapibi.xm.com.co (publico)
# SIMEM Colombia: https://www.simem.co (publico)
